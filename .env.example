# ─────────────────────────────────────────────────────────────
# Verkstadsgolvet — miljövariabler
# Kopiera till .env.local för lokal utveckling, och lägg in samma
# nycklar som ENCRYPTED variables i Railway. .env* är gitignorerat.
# INGEN av dessa får någonsin prefixas med NEXT_PUBLIC_ (invariant 2).
# ─────────────────────────────────────────────────────────────

# --- Auth (NextAuth v5 / Auth.js) ---
# Generera en hemlighet med:  openssl rand -base64 32
AUTH_SECRET=
# Publik URL till appen i produktion (Railway-domänen), t.ex. https://verkstadsgolvet.up.railway.app
# Lokalt kan den utelämnas (default http://localhost:3000).
AUTH_URL=
# Inloggningsuppgifter för den enda interna användaren (Johnny).
AUTH_USERNAME=
AUTH_PASSWORD=

# --- GitHub: LÄS-only (dashboarden) ---
# Fine-grained PAT, ENDAST "Contents: Read-only" på de aktuella privata repona.
# Ingen write, ingen admin, ingen org-scope. Se README för hur den skapas.
GITHUB_TOKEN_READ=
# Kontot/organisationen som äger repona (t.ex. "nortropic" eller ditt användarnamn).
GITHUB_OWNER=
# Exakt namn på Workflow/system-repot som doctor/retro/nattman-data läses från.
WORKFLOW_REPO=

# --- GitHub: SKRIV (onboarding — byggs SIST, bakom flagga) ---
# Separat fine-grained PAT med "Contents: Read and write" ENDAST för repo-skapande.
# Lämna tom tills onboarding aktiveras.
GITHUB_TOKEN_WRITE=

# --- Claude API (onboarding-research — byggs SIST, bakom flagga) ---
# Lämna tom tills onboarding aktiveras.
ANTHROPIC_API_KEY=

# --- Feature flag: skrivande onboarding-flöde ---
# Håll "false" tills token, auth och flöde är bekräftade. Sätt "true" för att aktivera.
ONBOARDING_ENABLED=false

# --- Leads-modul: Supabase (nytt EU-projekt) ---
# Server-side. Service-key kringgår RLS — får ALDRIG nå klienten / NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Leads-modul: svep-worker ---
# n8n cron pingar POST /api/leads/worker/run med headern x-webhook-secret = N8N_WEBHOOK_SECRET.
# Den skyddar worker-endpointen (som är undantagen session-gaten). Samma hemlighet som n8n har.
N8N_WEBHOOK_SECRET=
# Google Places API (New)-nyckeln. Appen gör Places-anropen server-side i workern.
# Server-only, aldrig NEXT_PUBLIC_. Begränsa nyckeln till Places API (New) + ha budgetlarm.
PLACES_API_KEY=
